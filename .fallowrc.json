{
  "$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",
  "duplicates": {
    "enabled": true,
    "minOccurrences": 3,
    "ignoreImports": true
  },
  "ignoreDependencies": [
    "next-devtools-mcp",
    "typescript-plugin-directives",
    "shadcn",
    "inngest-cli",
    "babel-plugin-react-compiler",
    "@elysiajs/openapi",
    "react-doctor"
  ],
  "ignorePatterns": [
    "apps/web/src/shims/kysely-adapter.ts",
    "doctor.config.ts"
  ],
  "ignoreExports": [
    { "file": "apps/web/src/components/ui/**", "exports": ["*"] }
  ],
  "overrides": [],
  "health": {
    "maxCyclomatic": 20,
    "maxCognitive": 20,
    "maxCrap": 80
  },
  "rules": {
    "prop-drilling": "warn",
    "thin-wrapper": "warn",
    "duplicate-prop-shape": "warn",
    "unused-dependency-overrides": "off"
  }
}
