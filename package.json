{
  "name": "firstroad",
  "version": "0.7.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "auth:schema": "turbo run auth:schema --filter=@firstroad/web",
    "build": "turbo run build",
    "build:debug": "turbo run build:debug",
    "build:debug:prerender": "turbo run build:debug:prerender",
    "build:email": "turbo run build:email",
    "check": "ultracite check",
    "clear:attachments": "turbo run clear:attachments --filter=@firstroad/db",
    "clear:non-auth": "turbo run clear:non-auth --filter=@firstroad/db",
    "deploy:prod": "vercel deploy --prod",
    "dev": "turbo run dev --filter=@firstroad/web",
    "dev:inspect": "turbo run dev:inspect",
    "doctor": "ultracite doctor",
    "export:email": "turbo run export:email",
    "fix": "ultracite fix",
    "postinstall": "turbo run postinstall",
    "prepare": "husky",
    "react-doctor": "bunx react-doctor@latest --offline",
    "resend:download": "turbo run resend:download --filter=@firstroad/web",
    "resend:list": "turbo run resend:list --filter=@firstroad/web",
    "reset:tickets": "turbo run reset:tickets --filter=@firstroad/web",
    "seed:members": "turbo run seed:members --filter=@firstroad/db",
    "start": "turbo run start",
    "type": "turbo run type",
    "typegen": "turbo run typegen",
    "ultracite:upgrade": "ultracite upgrade --pm bun"
  },
  "overrides": {
    "@hono/node-server@<1.19.15": "1.19.15",
    "@modelcontextprotocol/sdk@<=1.25.3": "1.26.0",
    "@opentelemetry/core@<2.8.0": "2.8.0",
    "@opentelemetry/propagator-jaeger@<2.9.0": "2.9.0",
    "hono@<4.13.5": "4.13.5",
    "ip-address@<=10.3.0": "10.4.0",
    "lodash@<=4.17.23": "4.18.1",
    "valibot@<1.4.2": "1.4.2"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.12",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.0",
    "react-doctor": "^0.9.13",
    "turbo": "^2.10.12",
    "typescript": "^7.0.2",
    "ultracite": "7.11.0"
  },
  "packageManager": "bun@1.4.2",
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.4.2"
    }
  }
}
